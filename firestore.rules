rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidUsername(name) {
      return name is string 
        && name.size() >= 3 
        && name.size() <= 18
        && name.matches('^[a-zA-Z0-9_]+$');
    }

    function isValidStats(data) {
      return data.keys().hasAll(['username', 'feverPoints'])
        && isValidUsername(data.username)
        && data.feverPoints is number 
        && data.feverPoints >= 0 
        && data.feverPoints <= 1000000;
    }

    function isValidLeaderboard(data) {
      return data.keys().hasAll(['username', 'feverPoints', 'updatedAt'])
        && isValidUsername(data.username)
        && data.feverPoints is number 
        && data.feverPoints >= 0
        && data.feverPoints <= 1000000;
    }

    function isValidBugReport(data) {
      return data.keys().hasAll(['message', 'category', 'createdAt'])
        && data.message is string 
        && data.message.size() >= 5 
        && data.message.size() <= 2000
        && (data.category == 'BUG' || data.category == 'SUGGESTION' || data.category == 'BALANCE')
        && data.createdAt is timestamp;
    }

    // ── User Stats ────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidStats(request.resource.data);
    }

    // ── Unique Usernames Registry ──────────────────────────────────────
    // Document ID is lowercase username, content contains { uid: string, originalName: string, createdAt: timestamp }
    match /usernames/{lowerUsername} {
      allow read: if true;
      allow create: if isAuthenticated() 
        && request.resource.data.uid == request.auth.uid
        && lowerUsername == request.resource.data.lowerName
        && isValidUsername(request.resource.data.originalName);
      allow update: if false; // Usernames are permanent or deleted to change
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ── Global Leaderboard ────────────────────────────────────────────
    // Publicly readable so everyone sees real player rankings
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if isOwner(uid) && isValidLeaderboard(request.resource.data);
    }

    // ── Bug Reports & Suggestions ─────────────────────────────────────
    // Playtesters can submit reports; reports cannot be altered or deleted by users
    match /bugReports/{reportId} {
      allow create: if isValidBugReport(request.resource.data);
      allow read: if isOwner(resource.data.uid);
      allow update, delete: if false; // Admins review/manage in Firebase Console
    }
  }
}
